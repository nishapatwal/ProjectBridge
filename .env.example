# ProjectBridge Environment Variables
# Copy this file to .env.local and populate with your Supabase credentials.

# Public Supabase API configuration (Browser & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Secret Supabase Service Role Key (SERVER ONLY - never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
